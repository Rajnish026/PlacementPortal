@{
    ViewData["Title"] = "Access Denied";
}

<div class="row justify-content-center py-5">
    <div class="col-md-6 text-center">
        <div class="card border-0 shadow-sm rounded-4 p-4 p-md-5">
            <div class="d-inline-flex align-items-center justify-content-center bg-danger bg-opacity-10 text-danger rounded-circle mx-auto mb-3" style="width: 72px; height: 72px;">
                <i class="bi bi-shield-x fs-1"></i>
            </div>
            <h2 class="fw-bold text-danger mb-2">Access Restricted</h2>
            <p class="text-muted mb-4">
                You do not have the required role or administrative permissions to access this page.
                If you believe this is an error, please contact your College Placement Officer.
            </p>
            <div class="d-flex justify-content-center gap-2">
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                    <i class="bi bi-house me-1"></i> Return Home
                </a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                        <button type="submit" class="btn btn-danger rounded-pill px-4">
                            <i class="bi bi-box-arrow-right me-1"></i> Switch Account
                        </button>
                    </form>
                }
                else
                {
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary rounded-pill px-4">
                        <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                    </a>
                }
            </div>
        </div>
    </div>
</div>
