@model RegisterViewModel
@{
    ViewData["Title"] = "Student Registration";
}

<div class="row justify-content-center py-3 py-md-4">
    <div class="col-md-8 col-lg-7 col-xl-6">
        <div class="card border-0 shadow-sm rounded-4">
            <div class="card-body p-3 p-md-4 p-lg-5">
                <div class="text-center mb-4">
                    <div class="d-inline-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary rounded-circle mb-3" style="width: 56px; height: 56px;">
                        <i class="bi bi-person-plus-fill fs-3"></i>
                    </div>
                    <h3 class="fw-bold mb-1">Create Student Account</h3>
                    <p class="text-muted small">Register to browse campus drives, track internship applications, and build your placement profile.</p>
                </div>

                <form asp-action="Register" method="post" novalidate>
                    <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3" role="alert"></div>

                    <!-- Full Name -->
                    <div class="mb-3">
                        <label asp-for="FullName" class="form-label fw-semibold small"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-person"></i></span>
                            <input asp-for="FullName" class="form-control border-start-0 ps-0" placeholder="e.g. Rahul Sharma" />
                        </div>
                        <span asp-validation-for="FullName" class="text-danger small"></span>
                    </div>

                    <!-- Email Address -->
                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-semibold small"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-envelope"></i></span>
                            <input asp-for="Email" type="email" class="form-control border-start-0 ps-0" placeholder="student@college.edu" />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <!-- Roll Number -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="RollNumber" class="form-label fw-semibold small"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-card-text"></i></span>
                                <input asp-for="RollNumber" class="form-control border-start-0 ps-0 text-uppercase" placeholder="21BCSE042" />
                            </div>
                            <span asp-validation-for="RollNumber" class="text-danger small"></span>
                        </div>

                        <!-- Graduation Year -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="GraduationYear" class="form-label fw-semibold small"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-calendar3"></i></span>
                                <select asp-for="GraduationYear" class="form-select border-start-0 ps-0">
                                    <option value="">Select Passing Year</option>
                                    <option value="2024">2024</option>
                                    <option value="2025">2025</option>
                                    <option value="2026">2026</option>
                                    <option value="2027">2027</option>
                                    <option value="2028">2028</option>
                                </select>
                            </div>
                            <span asp-validation-for="GraduationYear" class="text-danger small"></span>
                        </div>
                    </div>

                    <!-- Department -->
                    <div class="mb-3">
                        <label asp-for="Department" class="form-label fw-semibold small"></label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-mortarboard"></i></span>
                            <select asp-for="Department" class="form-select border-start-0 ps-0">
                                <option value="">Select Department / Branch</option>
                                <option value="Computer Science & Engineering">Computer Science & Engineering (CSE)</option>
                                <option value="Information Technology">Information Technology (IT)</option>
                                <option value="Electronics & Communication Engineering">Electronics & Communication (ECE)</option>
                                <option value="Electrical & Electronics Engineering">Electrical & Electronics (EEE)</option>
                                <option value="Mechanical Engineering">Mechanical Engineering</option>
                                <option value="Civil Engineering">Civil Engineering</option>
                                <option value="Master of Computer Applications">Master of Computer Applications (MCA)</option>
                            </select>
                        </div>
                        <span asp-validation-for="Department" class="text-danger small"></span>
                    </div>

                    <div class="row">
                        <!-- Password -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="Password" class="form-label fw-semibold small"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-lock"></i></span>
                                <input asp-for="Password" class="form-control border-start-0 ps-0" placeholder="Min. 6 chars" />
                            </div>
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <!-- Confirm Password -->
                        <div class="col-md-6 mb-3">
                            <label asp-for="ConfirmPassword" class="form-label fw-semibold small"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-shield-lock"></i></span>
                                <input asp-for="ConfirmPassword" class="form-control border-start-0 ps-0" placeholder="Re-enter password" />
                            </div>
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>
                    </div>

                    <div class="d-grid mt-4">
                        <button type="submit" class="btn btn-primary btn-lg rounded-3 fw-semibold">
                            <i class="bi bi-arrow-right-circle me-1"></i> Complete Registration
                        </button>
                    </div>
                </form>

                <div class="text-center mt-4 pt-3 border-top">
                    <p class="text-muted small mb-0">
                        Already have an account? 
                        <a asp-action="Login" class="text-decoration-none fw-semibold">Sign In here</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
