@model JobDetailsViewModel
@{
    var job = Model.Job;
    ViewData["Title"] = $"{job.Title} - {job.CompanyName}";
    var daysRemaining = (job.Deadline.Date - DateTime.Today).Days;
    var isExpired = daysRemaining < 0;
}

<div class="py-4">
    <!-- Breadcrumb Navigation -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Home</a></li>
            <li class="breadcrumb-item"><a asp-controller="Jobs" asp-action="Index" class="text-decoration-none">Drives</a></li>
            <li class="breadcrumb-item active text-truncate" aria-current="page" style="max-width: 300px;">@job.Title</li>
        </ol>
    </nav>

    <!-- Top Drive Header Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white overflow-hidden">
        <div class="card-body p-3 p-md-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-start gap-3 mb-3">
                <div>
                    <div class="d-flex flex-wrap align-items-center gap-2 mb-2">
                        <span class="badge @(job.JobType == "Internship" ? "bg-info bg-opacity-10 text-info border border-info-subtle" : "bg-success bg-opacity-10 text-success border border-success-subtle") px-3 py-1 rounded-pill fw-semibold">
                            <i class="bi @(job.JobType == "Internship" ? "bi-mortarboard" : "bi-briefcase") me-1"></i> @job.JobType
                        </span>

                        @if (isExpired || !job.IsActive)
                        {
                            <span class="badge bg-danger bg-opacity-10 text-danger border border-danger-subtle px-3 py-1 rounded-pill">
                                <i class="bi bi-x-circle me-1"></i> Applications Closed
                            </span>
                        }
                        else
                        {
                            <span class="badge bg-success bg-opacity-10 text-success border border-success-subtle px-3 py-1 rounded-pill">
                                <i class="bi bi-check-circle me-1"></i> Accepting Applications
                            </span>
                        }

                        @if (Model.HasApplied)
                        {
                            <span class="badge bg-primary px-3 py-1 rounded-pill">
                                <i class="bi bi-check2-all me-1"></i> Applied
                            </span>
                        }
                    </div>

                    <h2 class="page-title fw-bold text-dark mb-1">@job.Title</h2>
                    <h5 class="text-primary fw-semibold mb-3">
                        <i class="bi bi-building me-1"></i> @job.CompanyName
                    </h5>

                    <div class="d-flex flex-wrap gap-3 gap-md-4 text-muted small">
                        <div><i class="bi bi-geo-alt text-danger me-1"></i> @job.Location</div>
                        <div><i class="bi bi-cash-stack text-success me-1"></i> <strong class="text-dark">@(job.SalaryOrStipend ?? "As per policy")</strong></div>
                        <div><i class="bi bi-calendar-event text-primary me-1"></i> Deadline: <strong class="text-dark">@job.Deadline.ToString("dd MMMM yyyy")</strong></div>
                        <div><i class="bi bi-clock-history text-secondary me-1"></i> Posted: @job.CreatedAt.ToString("dd MMM yyyy")</div>
                    </div>
                </div>

                <div class="d-none d-md-block text-end">
                    <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
                        <i class="bi bi-arrow-left me-1"></i> Back to Drives
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content & Application Sidebar -->
    <div class="row g-4">
        <!-- Main Column: Description, Eligibility, Requirements -->
        <div class="col-lg-8">
            <!-- Job Description -->
            <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
                <div class="card-body p-3 p-md-4">
                    <h5 class="fw-bold text-dark mb-3">
                        <i class="bi bi-card-text text-primary me-2"></i> About the Role & Opportunity
                    </h5>
                    <p class="text-secondary lh-lg mb-0" style="white-space: pre-line;">@job.Description</p>
                </div>
            </div>

            <!-- Requirements & Eligibility -->
            <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
                <div class="card-body p-3 p-md-4">
                    <h5 class="fw-bold text-dark mb-3">
                        <i class="bi bi-list-check text-primary me-2"></i> Key Skills & Eligibility Requirements
                    </h5>

                    @if (!string.IsNullOrWhiteSpace(job.Requirements))
                    {
                        <p class="text-secondary lh-lg mb-4" style="white-space: pre-line;">@job.Requirements</p>
                    }
                    else
                    {
                        <p class="text-muted fst-italic mb-4">No specific technical prerequisites listed by recruiter.</p>
                    }

                    <div class="row g-3 pt-2">
                        <div class="col-md-6">
                            <div class="p-3 rounded-3 bg-light border">
                                <div class="text-muted small mb-1"><i class="bi bi-award text-warning me-1"></i> Minimum Academic Cutoff</div>
                                <div class="fw-bold fs-6 text-dark">
                                    @(job.MinCgpa > 0 ? $"{job.MinCgpa:F2} CGPA or above" : "No minimum CGPA required")
                                </div>
                            </div>
                        </div>
                        <div class="col-md-6">
                            <div class="p-3 rounded-3 bg-light border">
                                <div class="text-muted small mb-1"><i class="bi bi-mortarboard text-info me-1"></i> Eligible Branches / Streams</div>
                                <div class="fw-bold fs-6 text-dark">
                                    @(job.EligibleDepartments ?? "All Engineering & Computing Branches")
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Sidebar Column: Summary & Application Actions -->
        <div class="col-lg-4">
            <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white sticky-sidebar-card">
                <div class="card-body p-3 p-md-4">
                    <h5 class="fw-bold text-dark mb-3">Drive Overview</h5>

                    <ul class="list-unstyled mb-4">
                        <li class="d-flex justify-content-between py-2 border-bottom">
                            <span class="text-muted small">Company</span>
                            <span class="fw-semibold text-dark small text-truncate text-end ms-2" style="max-width: 55%;">@job.CompanyName</span>
                        </li>
                        <li class="d-flex justify-content-between py-2 border-bottom">
                            <span class="text-muted small">Opportunity Type</span>
                            <span class="fw-semibold text-dark small">@job.JobType</span>
                        </li>
                        <li class="d-flex justify-content-between py-2 border-bottom">
                            <span class="text-muted small">Package / Stipend</span>
                            <span class="fw-bold text-success small text-truncate text-end ms-2" style="max-width: 55%;">@(job.SalaryOrStipend ?? "As per policy")</span>
                        </li>
                        <li class="d-flex justify-content-between py-2 border-bottom">
                            <span class="text-muted small">Minimum CGPA</span>
                            <span class="fw-semibold text-dark small">@(job.MinCgpa > 0 ? $"{job.MinCgpa:F1}" : "No Bar")</span>
                        </li>
                        <li class="d-flex justify-content-between py-2 border-bottom">
                            <span class="text-muted small">Location</span>
                            <span class="fw-semibold text-dark small text-truncate text-end ms-2" style="max-width: 55%;">@job.Location</span>
                        </li>
                        <li class="d-flex justify-content-between py-2">
                            <span class="text-muted small">Application Deadline</span>
                            <span class="fw-semibold text-dark small">@job.Deadline.ToString("dd MMM yyyy")</span>
                        </li>
                    </ul>

                    <!-- Application Section -->
                    <div class="mb-3">
                        @if (Model.HasApplied)
                        {
                            <!-- Student has already applied -->
                            <div class="p-3 rounded-3 bg-success bg-opacity-10 border border-success-subtle mb-3 text-center">
                                <i class="bi bi-check-circle-fill text-success fs-3 d-block mb-1"></i>
                                <h6 class="fw-bold text-success mb-1">Application Submitted</h6>
                                <p class="text-muted small mb-2">Applied on @Model.AppliedDate?.ToString("dd MMM yyyy, hh:mm tt")</p>
                                <div class="badge bg-primary px-3 py-1 rounded-pill">Status: @Model.ApplicationStatus</div>
                            </div>
                            <div class="d-grid">
                                <a asp-controller="Student" asp-action="MyApplications" class="btn btn-outline-primary rounded-3 fw-semibold">
                                    <i class="bi bi-clock-history me-1"></i> View in My Applications
                                </a>
                            </div>
                        }
                        else if (!job.IsActive || isExpired)
                        {
                            <!-- Drive is closed -->
                            <div class="p-3 rounded-3 bg-danger bg-opacity-10 border border-danger-subtle text-center mb-3">
                                <i class="bi bi-x-circle-fill text-danger fs-3 d-block mb-1"></i>
                                <h6 class="fw-bold text-danger mb-1">Applications Closed</h6>
                                <p class="text-muted small mb-0">This drive is no longer accepting new submissions.</p>
                            </div>
                        }
                        else if (User.Identity?.IsAuthenticated == true && User.IsInRole("Student"))
                        {
                            <!-- Logged-in Student can Apply -->
                            @if (!Model.IsEligible)
                            {
                                <div class="alert alert-warning small rounded-3 mb-3">
                                    <i class="bi bi-exclamation-triangle-fill me-1"></i>
                                    @Model.EligibilityMessage
                                </div>
                            }

                            <form asp-action="Apply" method="post">
                                <input type="hidden" name="jobListingId" value="@job.Id" />
                                
                                <div class="mb-3">
                                    <label class="form-label small fw-semibold text-muted">Statement of Interest / Cover Note (Optional)</label>
                                    <textarea name="coverNote" 
                                              class="form-control" 
                                              rows="3" 
                                              maxlength="500" 
                                              placeholder="Briefly highlight your relevant skills, projects, or certifications..."></textarea>
                                </div>

                                <div class="d-grid">
                                    <button type="submit" class="btn btn-primary btn-lg rounded-3 fw-semibold shadow-sm">
                                        <i class="bi bi-send-fill me-1"></i> Submit Application
                                    </button>
                                </div>
                            </form>
                        }
                        else if (User.Identity?.IsAuthenticated == true && User.IsInRole("Admin"))
                        {
                            <!-- Admin visitor -->
                            <div class="alert alert-secondary small rounded-3 text-center mb-0">
                                <i class="bi bi-shield-lock me-1"></i> Viewing as Administrator.
                            </div>
                        }
                        else
                        {
                            <!-- Unauthenticated visitor -->
                            <div class="d-grid gap-2">
                                <a asp-controller="Account" asp-action="Login" asp-route-returnUrl="/Jobs/Details/@job.Id" class="btn btn-primary btn-lg rounded-3 fw-semibold shadow-sm">
                                    <i class="bi bi-box-arrow-in-right me-1"></i> Sign In to Apply
                                </a>
                                <div class="text-center small text-muted">
                                    Don't have an account? <a asp-controller="Account" asp-action="Register" class="text-decoration-none fw-semibold">Register here</a>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="d-grid mt-3">
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-3">
                            <i class="bi bi-arrow-left me-1"></i> Back to All Drives
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
