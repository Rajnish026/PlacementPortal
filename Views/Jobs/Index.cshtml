@model JobListViewModel
@{
    ViewData["Title"] = "Placement & Internship Drives";
}

<div class="py-4">
    <!-- Page Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-2 border-bottom">
        <div>
            <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-1 rounded-pill small fw-semibold mb-2">
                <i class="bi bi-briefcase-fill me-1"></i> Campus Recruitment Portal
            </span>
            <h2 class="h3 fw-bold mb-1">Campus Placement & Internship Drives</h2>
            <p class="text-muted mb-0 small">Browse and filter verified opportunities posted by the College Placement Cell</p>
        </div>
        <div class="mt-3 mt-md-0">
            <span class="badge bg-white text-dark border shadow-xs px-3 py-2 rounded-pill fs-6">
                <span class="fw-bold text-primary">@Model.TotalResultsCount</span> Opportunities Available
            </span>
        </div>
    </div>

    <!-- Search & Filter Card -->
    <div class="card border-0 shadow-sm rounded-4 mb-4 bg-white">
        <div class="card-body p-3 p-md-4">
            <form method="get" asp-action="Index" id="filterForm">
                <div class="row g-3">
                    <!-- Search Input -->
                    <div class="col-lg-4 col-md-6">
                        <label class="form-label small fw-semibold text-muted">Keyword Search</label>
                        <div class="input-group">
                            <span class="input-group-text bg-light border-end-0 text-muted">
                                <i class="bi bi-search"></i>
                            </span>
                            <input type="text" 
                                   name="searchTerm" 
                                   value="@Model.SearchTerm" 
                                   class="form-control border-start-0 ps-0" 
                                   placeholder="Title or Company (e.g. Microsoft, Intern)..." />
                        </div>
                    </div>

                    <!-- Job Type Filter -->
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label small fw-semibold text-muted">Opportunity Type</label>
                        <select name="jobType" class="form-select">
                            <option value="All" selected="@(Model.JobType == "All")">All Types (Internship & Jobs)</option>
                            <option value="Full-Time" selected="@(Model.JobType == "Full-Time")">Full-Time Only</option>
                            <option value="Internship" selected="@(Model.JobType == "Internship")">Internships Only</option>
                        </select>
                    </div>

                    <!-- Location Filter -->
                    <div class="col-lg-3 col-md-6">
                        <label class="form-label small fw-semibold text-muted">Location</label>
                        <select name="location" class="form-select">
                            <option value="All" selected="@(Model.Location == "All")">All Locations</option>
                            @foreach (var loc in Model.AvailableLocations)
                            {
                                <option value="@loc" selected="@(Model.Location == loc)">@loc</option>
                            }
                        </select>
                    </div>

                    <!-- Filter Buttons -->
                    <div class="col-lg-2 col-md-6 d-flex align-items-end gap-2">
                        <button type="submit" class="btn btn-primary w-100 rounded-3 fw-semibold text-nowrap">
                            <i class="bi bi-funnel me-1"></i> Filter
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary rounded-3 text-nowrap" title="Clear all filters">
                            <i class="bi bi-arrow-counterclockwise"></i>
                        </a>
                    </div>
                </div>

                <!-- Active Only Filter Checkbox -->
                <div class="mt-3 pt-3 border-top d-flex flex-wrap align-items-center justify-content-between gap-2">
                    <div class="form-check form-switch mb-0">
                        <input class="form-check-input" 
                               type="checkbox" 
                               role="switch" 
                               id="onlyActiveSwitch" 
                               name="onlyActive" 
                               value="true" 
                               @(Model.OnlyActive ? "checked" : "") 
                               onchange="document.getElementById('filterForm').submit();">
                        <input type="hidden" name="onlyActive" value="false" />
                        <label class="form-check-label small text-muted" for="onlyActiveSwitch">
                            Show only active & accepting applications
                        </label>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.SearchTerm) || Model.JobType != "All" || Model.Location != "All")
                    {
                        <div class="d-flex flex-wrap align-items-center gap-1 small text-muted">
                            <span>Active filters:</span>
                            @if (!string.IsNullOrWhiteSpace(Model.SearchTerm))
                            {
                                <span class="badge bg-light text-dark border">"@Model.SearchTerm"</span>
                            }
                            @if (Model.JobType != "All")
                            {
                                <span class="badge bg-light text-dark border">@Model.JobType</span>
                            }
                            @if (Model.Location != "All")
                            {
                                <span class="badge bg-light text-dark border">@Model.Location</span>
                            }
                            <a asp-action="Index" class="text-danger small ms-1 text-decoration-none fw-semibold">Clear</a>
                        </div>
                    }
                </div>
            </form>
        </div>
    </div>

    <!-- Job Cards or Empty State -->
    @if (Model.Jobs.Any())
    {
        <div class="row g-4">
            @foreach (var job in Model.Jobs)
            {
                var daysRemaining = (job.Deadline.Date - DateTime.Today).Days;
                var isExpired = daysRemaining < 0;

                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 border-0 shadow-sm rounded-4 hover-shadow transition bg-white d-flex flex-column">
                        <div class="card-body p-4 d-flex flex-column">
                            <!-- Card Header -->
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge @(job.JobType == "Internship" ? "bg-info bg-opacity-10 text-info border border-info-subtle" : "bg-success bg-opacity-10 text-success border border-success-subtle") px-3 py-1 rounded-pill small fw-semibold">
                                    <i class="bi @(job.JobType == "Internship" ? "bi-mortarboard" : "bi-briefcase") me-1"></i> @job.JobType
                                </span>

                                @if (isExpired)
                                {
                                    <span class="badge bg-danger bg-opacity-10 text-danger rounded-pill small">
                                        <i class="bi bi-x-circle me-1"></i> Closed
                                    </span>
                                }
                                else if (daysRemaining <= 5)
                                {
                                    <span class="badge bg-warning bg-opacity-25 text-dark rounded-pill small fw-semibold">
                                        <i class="bi bi-clock-history me-1"></i> @daysRemaining days left
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted small">
                                        <i class="bi bi-calendar-event me-1"></i> Due @job.Deadline.ToString("dd MMM yyyy")
                                    </span>
                                }
                            </div>

                            <!-- Title & Company -->
                            <h5 class="fw-bold text-dark mb-1 mt-2">
                                <a asp-action="Details" asp-route-id="@job.Id" class="text-decoration-none text-dark stretched-link">
                                    @job.Title
                                </a>
                            </h5>
                            <div class="text-primary fw-semibold small mb-3">
                                <i class="bi bi-building me-1"></i> @job.CompanyName
                            </div>

                            <!-- Snippet -->
                            <p class="text-secondary small line-clamp-3 mb-3 flex-grow-1">
                                @job.Description
                            </p>

                            <!-- Key Specs Box -->
                            <div class="bg-light rounded-3 p-3 my-2 small border">
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="text-muted"><i class="bi bi-geo-alt me-1"></i> Location:</span>
                                    <span class="fw-semibold text-dark text-truncate text-end ms-2" style="max-width: 55%;">@job.Location</span>
                                </div>
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="text-muted"><i class="bi bi-cash-stack me-1"></i> Package / Stipend:</span>
                                    <span class="fw-bold text-success text-truncate text-end ms-2" style="max-width: 55%;">@(job.SalaryOrStipend ?? "As per policy")</span>
                                </div>
                                <div class="d-flex justify-content-between mb-1">
                                    <span class="text-muted"><i class="bi bi-award me-1"></i> Min. CGPA:</span>
                                    <span class="fw-semibold text-dark text-end ms-2">@(job.MinCgpa > 0 ? $"{job.MinCgpa:F1} CGPA" : "No Bar")</span>
                                </div>
                                <div class="d-flex justify-content-between">
                                    <span class="text-muted"><i class="bi bi-diagram-3 me-1"></i> Branches:</span>
                                    <span class="fw-semibold text-dark text-truncate text-end ms-2" style="max-width: 55%;">@(job.EligibleDepartments ?? "All Branches")</span>
                                </div>
                            </div>

                            <!-- Card Action Button -->
                            <div class="mt-3 pt-2 position-relative" style="z-index: 2;">
                                <a asp-action="Details" asp-route-id="@job.Id" class="btn btn-outline-primary w-100 rounded-3 fw-semibold">
                                    <i class="bi bi-eye me-1"></i> View Drive Details
                                </a>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white my-4">
            <div class="d-inline-flex align-items-center justify-content-center bg-light text-secondary rounded-circle mx-auto mb-3" style="width: 80px; height: 80px;">
                <i class="bi bi-search fs-1"></i>
            </div>
            <h4 class="fw-bold mb-2">No Matching Opportunities Found</h4>
            <p class="text-muted mx-auto mb-4" style="max-width: 500px;">
                We couldn't find any campus drives matching your specific search filters. Try using different keywords, clearing the location filter, or resetting all options.
            </p>
            <div>
                <a asp-action="Index" class="btn btn-primary rounded-pill px-4 fw-semibold">
                    <i class="bi bi-arrow-counterclockwise me-1"></i> Reset All Filters
                </a>
            </div>
        </div>
    }
</div>
