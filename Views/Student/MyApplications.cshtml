@model IEnumerable<JobApplication>
@{
    ViewData["Title"] = "My Applications";
}

<div class="py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Home</a></li>
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Student Dashboard</a></li>
            <li class="breadcrumb-item active" aria-current="page">My Applications</li>
        </ol>
    </nav>

    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-2 border-bottom gap-2">
        <div>
            <span class="badge bg-primary bg-opacity-10 text-primary px-3 py-1 rounded-pill small fw-semibold mb-2">
                <i class="bi bi-clock-history me-1"></i> Application Tracker
            </span>
            <h2 class="h3 fw-bold mb-1">My Campus Applications</h2>
            <p class="text-muted mb-0 small">Track real-time status and reviews for all placement and internship drives you applied to</p>
        </div>
        <div class="mt-2 mt-md-0 d-flex flex-wrap gap-2">
            <a asp-action="Profile" class="btn btn-outline-secondary rounded-pill px-3">
                <i class="bi bi-person-gear me-1"></i> Update Profile
            </a>
            <a asp-controller="Jobs" asp-action="Index" class="btn btn-primary rounded-pill px-3 shadow-xs">
                <i class="bi bi-search me-1"></i> Explore Drives
            </a>
        </div>
    </div>

    <!-- Applications List or Empty State -->
    @if (Model.Any())
    {
        <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 table-min-width-md">
                    <thead class="table-light text-muted small text-uppercase">
                        <tr>
                            <th class="ps-4 py-3">Role & Company</th>
                            <th class="py-3">Type</th>
                            <th class="py-3">Applied On</th>
                            <th class="py-3">Status</th>
                            <th class="pe-4 py-3 text-end">Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var app in Model)
                        {
                            var job = app.JobListing!;
                            string statusBadgeClass = app.Status switch
                            {
                                "Selected" => "bg-success text-white",
                                "Shortlisted" => "bg-primary text-white",
                                "Under Review" => "bg-info bg-opacity-25 text-dark fw-semibold",
                                "Rejected" => "bg-danger text-white",
                                _ => "bg-secondary bg-opacity-10 text-secondary border"
                            };

                            <tr>
                                <td class="ps-4 py-3">
                                    <div class="fw-bold text-dark fs-6">
                                        <a asp-controller="Jobs" asp-action="Details" asp-route-id="@app.JobListingId" class="text-decoration-none text-dark">
                                            @job.Title
                                        </a>
                                    </div>
                                    <div class="text-primary small fw-semibold">
                                        <i class="bi bi-building me-1"></i> @job.CompanyName
                                    </div>
                                    <div class="text-muted small">
                                        <i class="bi bi-geo-alt me-1"></i> @job.Location | <span class="text-success fw-semibold">@(job.SalaryOrStipend ?? "N/A")</span>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge @(job.JobType == "Internship" ? "bg-info bg-opacity-10 text-info border border-info-subtle" : "bg-success bg-opacity-10 text-success border border-success-subtle") rounded-pill px-2 py-1 small">
                                        @job.JobType
                                    </span>
                                </td>
                                <td class="text-secondary small">
                                    <div>@app.AppliedAt.ToString("dd MMM yyyy")</div>
                                    <div class="text-muted" style="font-size: 0.75rem;">@app.AppliedAt.ToString("hh:mm tt")</div>
                                </td>
                                <td>
                                    <span class="badge @statusBadgeClass rounded-pill px-3 py-1">
                                        @app.Status
                                    </span>
                                    @if (!string.IsNullOrWhiteSpace(app.AdminRemarks))
                                    {
                                        <div class="text-muted small mt-1" style="font-size: 0.75rem;">
                                            <i class="bi bi-chat-left-quote me-1"></i> @app.AdminRemarks
                                        </div>
                                    }
                                </td>
                                <td class="pe-4 text-end">
                                    <a asp-controller="Jobs" asp-action="Details" asp-route-id="@app.JobListingId" class="btn btn-outline-primary btn-sm rounded-pill px-3">
                                        <i class="bi bi-eye me-1"></i> View Drive
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
    else
    {
        <!-- Empty State -->
        <div class="card border-0 shadow-sm rounded-4 p-5 text-center bg-white my-3">
            <div class="d-inline-flex align-items-center justify-content-center bg-light text-muted rounded-circle mx-auto mb-3" style="width: 80px; height: 80px;">
                <i class="bi bi-inbox-fill fs-1 text-primary text-opacity-50"></i>
            </div>
            <h4 class="fw-bold mb-2">No Applications Submitted Yet</h4>
            <p class="text-muted mx-auto mb-4" style="max-width: 480px;">
                You haven't submitted an application to any campus recruitment or internship drives. Browse the open drives to apply.
            </p>
            <div>
                <a asp-controller="Jobs" asp-action="Index" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
                    <i class="bi bi-search me-1"></i> Explore Active Drives
                </a>
            </div>
        </div>
    }
</div>
