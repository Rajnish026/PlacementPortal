@model StudentProfileViewModel
@{
    ViewData["Title"] = "Student Profile";
}

<div class="py-4">
    <!-- Breadcrumb Navigation -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index" class="text-decoration-none">Home</a></li>
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Student Dashboard</a></li>
            <li class="breadcrumb-item active" aria-current="page">Profile Settings</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-8">
            <div class="card border-0 shadow-sm rounded-4 bg-white">
                <div class="card-body p-3 p-md-4 p-lg-5">
                    <!-- Header -->
                    <div class="d-flex align-items-center mb-4 pb-3 border-bottom">
                        <div class="d-inline-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary rounded-circle p-3 me-3" style="width: 54px; height: 54px;">
                            <i class="bi bi-person-gear fs-3"></i>
                        </div>
                        <div>
                            <h4 class="fw-bold mb-1">Student Placement Profile</h4>
                            <p class="text-muted small mb-0">Keep your academic information and resume updated for placement screening.</p>
                        </div>
                    </div>

                    <form asp-action="Profile" method="post" novalidate>
                        <input type="hidden" asp-for="Id" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3" role="alert"></div>

                        <!-- Read-Only Identity Details Banner -->
                        <div class="bg-light rounded-3 p-3 mb-4 border">
                            <div class="d-flex align-items-center text-muted small mb-2">
                                <i class="bi bi-shield-lock-fill me-1 text-primary"></i>
                                <span>Verified Academic Credentials (Read-Only)</span>
                            </div>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label text-muted small mb-0">Roll Number</label>
                                    <div class="fw-bold text-dark">
                                        <i class="bi bi-card-text me-1 text-secondary"></i> @Model.RollNumber
                                    </div>
                                    <input type="hidden" asp-for="RollNumber" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label text-muted small mb-0">Registered College Email</label>
                                    <div class="fw-bold text-dark">
                                        <i class="bi bi-envelope me-1 text-secondary"></i> @Model.Email
                                    </div>
                                    <input type="hidden" asp-for="Email" />
                                </div>
                            </div>
                        </div>

                        <!-- Editable Fields -->
                        <h6 class="fw-bold text-dark mb-3">Personal & Academic Details</h6>

                        <!-- Full Name -->
                        <div class="mb-3">
                            <label asp-for="FullName" class="form-label fw-semibold small"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-person"></i></span>
                                <input asp-for="FullName" class="form-control border-start-0 ps-0" placeholder="Your full name" />
                            </div>
                            <span asp-validation-for="FullName" class="text-danger small"></span>
                        </div>

                        <div class="row">
                            <!-- Department -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="Department" class="form-label fw-semibold small"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-mortarboard"></i></span>
                                    <select asp-for="Department" class="form-select border-start-0 ps-0">
                                        <option value="">Select Branch</option>
                                        <option value="Computer Science & Engineering">Computer Science & Engineering (CSE)</option>
                                        <option value="Information Technology">Information Technology (IT)</option>
                                        <option value="Electronics & Communication Engineering">Electronics & Communication (ECE)</option>
                                        <option value="Electrical & Electronics Engineering">Electrical & Electronics (EEE)</option>
                                        <option value="Mechanical Engineering">Mechanical Engineering</option>
                                        <option value="Civil Engineering">Civil Engineering</option>
                                        <option value="Master of Computer Applications">Master of Computer Applications (MCA)</option>
                                    </select>
                                </div>
                                <span asp-validation-for="Department" class="text-danger small"></span>
                            </div>

                            <!-- Graduation Year -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="GraduationYear" class="form-label fw-semibold small"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-calendar3"></i></span>
                                    <select asp-for="GraduationYear" class="form-select border-start-0 ps-0">
                                        <option value="">Select Year</option>
                                        <option value="2024">2024</option>
                                        <option value="2025">2025</option>
                                        <option value="2026">2026</option>
                                        <option value="2027">2027</option>
                                        <option value="2028">2028</option>
                                    </select>
                                </div>
                                <span asp-validation-for="GraduationYear" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <!-- CGPA -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="Cgpa" class="form-label fw-semibold small"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-award"></i></span>
                                    <input asp-for="Cgpa" type="number" step="0.01" min="0" max="10" class="form-control border-start-0 ps-0" placeholder="e.g. 8.45" />
                                </div>
                                <span class="form-text small text-muted">Used by placement cell to verify drive cutoffs.</span>
                                <span asp-validation-for="Cgpa" class="text-danger small d-block"></span>
                            </div>

                            <!-- Phone Number -->
                            <div class="col-md-6 mb-3">
                                <label asp-for="PhoneNumber" class="form-label fw-semibold small"></label>
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-telephone"></i></span>
                                    <input asp-for="PhoneNumber" type="tel" class="form-control border-start-0 ps-0" placeholder="+91 98765 43210" />
                                </div>
                                <span asp-validation-for="PhoneNumber" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Technical Skills -->
                        <div class="mb-3">
                            <label asp-for="Skills" class="form-label fw-semibold small"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-code-slash"></i></span>
                                <input asp-for="Skills" class="form-control border-start-0 ps-0" placeholder="e.g. C#, ASP.NET Core, SQL Server, Python, Data Structures" />
                            </div>
                            <span asp-validation-for="Skills" class="text-danger small"></span>
                        </div>

                        <!-- Resume Link -->
                        <div class="mb-4">
                            <label asp-for="ResumeUrl" class="form-label fw-semibold small"></label>
                            <div class="input-group">
                                <span class="input-group-text bg-light border-end-0 text-muted"><i class="bi bi-link-45deg"></i></span>
                                <input asp-for="ResumeUrl" type="url" class="form-control border-start-0 ps-0" placeholder="https://drive.google.com/your-resume-link" />
                            </div>
                            <span class="form-text small text-muted">Provide a shareable Google Drive, GitHub, or LinkedIn portfolio link.</span>
                            <span asp-validation-for="ResumeUrl" class="text-danger small d-block"></span>
                        </div>

                        <div class="d-flex flex-wrap justify-content-between align-items-center pt-3 border-top gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-4">
                                <i class="bi bi-arrow-left me-1"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
                                <i class="bi bi-check-lg me-1"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
