@model AdminDashboardViewModel
@{
    ViewData["Title"] = "Admin Placement Portal";
}

<div class="py-4">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-2 border-bottom gap-2">
        <div>
            <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-1 rounded-pill small fw-semibold mb-2">
                <i class="bi bi-shield-lock-fill me-1"></i> Placement Officer Console
            </span>
            <h2 class="h3 fw-bold mb-1">Placement Administration Dashboard</h2>
            <p class="text-muted mb-0 small">Overview of campus recruitment drives, student applications, and placement statistics</p>
        </div>
        <div class="mt-2 mt-md-0 d-flex flex-wrap gap-2">
            <a asp-action="CreateJob" class="btn btn-primary rounded-pill px-3 shadow-xs">
                <i class="bi bi-plus-circle me-1"></i> Post New Drive
            </a>
            <a asp-action="Applications" class="btn btn-outline-danger rounded-pill px-3">
                <i class="bi bi-person-check me-1"></i> Review Applications
            </a>
        </div>
    </div>

    <!-- 4 Key Stat Cards -->
    <div class="row g-3 mb-4">
        <!-- Total Students -->
        <div class="col-xl-3 col-md-6 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-3 me-3">
                        <i class="bi bi-people-fill fs-3"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Registered Students</div>
                        <h3 class="fw-bold mb-0 text-dark">@Model.TotalStudentsCount</h3>
                    </div>
                </div>
            </div>
        </div>

        <!-- Active Drives -->
        <div class="col-xl-3 col-md-6 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center">
                    <div class="bg-success bg-opacity-10 text-success rounded-3 p-3 me-3">
                        <i class="bi bi-briefcase-fill fs-3"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Active Drives</div>
                        <h3 class="fw-bold mb-0 text-success">@Model.ActiveJobListingsCount</h3>
                    </div>
                </div>
            </div>
        </div>

        <!-- Total Applications -->
        <div class="col-xl-3 col-md-6 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center">
                    <div class="bg-info bg-opacity-10 text-info rounded-3 p-3 me-3">
                        <i class="bi bi-file-earmark-text-fill fs-3"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Total Applications</div>
                        <h3 class="fw-bold mb-0 text-dark">@Model.TotalApplicationsCount</h3>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pending Reviews -->
        <div class="col-xl-3 col-md-6 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white h-100">
                <div class="d-flex align-items-center">
                    <div class="bg-warning bg-opacity-10 text-warning rounded-3 p-3 me-3">
                        <i class="bi bi-hourglass-split fs-3"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Pending Reviews</div>
                        <h3 class="fw-bold mb-0 text-warning">@Model.PendingReviewsCount</h3>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Quick Navigation Links -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <a asp-action="Jobs" class="card border-0 shadow-sm rounded-4 p-3 bg-white text-decoration-none hover-shadow transition d-flex flex-row align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                    <div class="bg-light rounded-circle p-2 me-3 text-primary"><i class="bi bi-building fs-4"></i></div>
                    <div>
                        <h6 class="fw-bold text-dark mb-0">Manage Job Drives</h6>
                        <span class="text-muted small">Create, edit, or close campus listings</span>
                    </div>
                </div>
                <i class="bi bi-chevron-right text-muted"></i>
            </a>
        </div>
        <div class="col-md-4">
            <a asp-action="Applications" class="card border-0 shadow-sm rounded-4 p-3 bg-white text-decoration-none hover-shadow transition d-flex flex-row align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                    <div class="bg-light rounded-circle p-2 me-3 text-success"><i class="bi bi-check2-square fs-4"></i></div>
                    <div>
                        <h6 class="fw-bold text-dark mb-0">Review Applications</h6>
                        <span class="text-muted small">Update student statuses & remarks</span>
                    </div>
                </div>
                <i class="bi bi-chevron-right text-muted"></i>
            </a>
        </div>
        <div class="col-md-4">
            <a asp-action="Students" class="card border-0 shadow-sm rounded-4 p-3 bg-white text-decoration-none hover-shadow transition d-flex flex-row align-items-center justify-content-between">
                <div class="d-flex align-items-center">
                    <div class="bg-light rounded-circle p-2 me-3 text-info"><i class="bi bi-mortarboard fs-4"></i></div>
                    <div>
                        <h6 class="fw-bold text-dark mb-0">Student Directory</h6>
                        <span class="text-muted small">View registered candidates & CGPA</span>
                    </div>
                </div>
                <i class="bi bi-chevron-right text-muted"></i>
            </a>
        </div>
    </div>

    <!-- Tables Row -->
    <div class="row g-4">
        <!-- Recent Applications Table -->
        <div class="col-lg-7">
            <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden h-100">
                <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-clock-history text-danger me-2"></i> Recent Applications
                    </h5>
                    <a asp-action="Applications" class="text-danger small text-decoration-none fw-semibold">
                        View All (@Model.TotalApplicationsCount) <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
                <div class="card-body p-0">
                    @if (Model.RecentApplications.Any())
                    {
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0 table-min-width-md">
                                <thead class="table-light text-muted small text-uppercase">
                                    <tr>
                                        <th class="ps-4">Candidate</th>
                                        <th>Company & Role</th>
                                        <th>Status</th>
                                        <th class="pe-4 text-end">Action</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var app in Model.RecentApplications)
                                    {
                                        string statusClass = app.Status switch
                                        {
                                            "Selected" => "bg-success text-white",
                                            "Shortlisted" => "bg-primary text-white",
                                            "Under Review" => "bg-info bg-opacity-25 text-dark fw-semibold",
                                            "Rejected" => "bg-danger text-white",
                                            _ => "bg-secondary bg-opacity-10 text-secondary border"
                                        };

                                        <tr>
                                            <td class="ps-4 py-3">
                                                <div class="fw-bold text-dark">@app.User?.FullName</div>
                                                <div class="text-muted small">@app.User?.RollNumber | @app.User?.Department</div>
                                            </td>
                                            <td>
                                                <div class="fw-semibold text-dark">@app.JobListing?.Title</div>
                                                <div class="text-primary small">@app.JobListing?.CompanyName</div>
                                            </td>
                                            <td>
                                                <span class="badge @statusClass rounded-pill px-3 py-1">
                                                    @app.Status
                                                </span>
                                            </td>
                                            <td class="pe-4 text-end">
                                                <a asp-action="Applications" asp-route-jobId="@app.JobListingId" class="btn btn-outline-secondary btn-sm rounded-pill">
                                                    Review
                                                </a>
                                            </td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                    else
                    {
                        <div class="p-5 text-center text-muted">
                            <i class="bi bi-inbox fs-1 d-block mb-2"></i>
                            <span>No student applications submitted yet.</span>
                        </div>
                    }
                </div>
            </div>
        </div>

        <!-- Recent Campus Drives Table -->
        <div class="col-lg-5">
            <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden h-100">
                <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
                    <h5 class="fw-bold mb-0 text-dark">
                        <i class="bi bi-building text-primary me-2"></i> Recent Job Drives
                    </h5>
                    <a asp-action="Jobs" class="text-primary small text-decoration-none fw-semibold">
                        View All <i class="bi bi-arrow-right"></i>
                    </a>
                </div>
                <div class="card-body p-0">
                    <ul class="list-group list-group-flush">
                        @foreach (var job in Model.RecentJobListings)
                        {
                            <li class="list-group-item px-4 py-3 d-flex justify-content-between align-items-center">
                                <div>
                                    <div class="fw-bold text-dark">@job.Title</div>
                                    <div class="text-muted small">
                                        <span class="text-primary fw-semibold">@job.CompanyName</span> &bull; @job.JobType
                                    </div>
                                    <div class="small text-muted">Deadline: @job.Deadline.ToString("dd MMM yyyy")</div>
                                </div>
                                <div class="text-end">
                                    <span class="badge @(job.IsActive ? "bg-success" : "bg-secondary") rounded-pill mb-2 d-block">
                                        @(job.IsActive ? "Active" : "Closed")
                                    </span>
                                    <a asp-action="EditJob" asp-route-id="@job.Id" class="btn btn-sm btn-outline-primary rounded-pill px-3">
                                        Edit
                                    </a>
                                </div>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>
    </div>
</div>
