@model IEnumerable<User>
@{
    ViewData["Title"] = "Registered Students Directory";
}

<div class="py-4">
    <!-- Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center mb-4 pb-2 border-bottom gap-2">
        <div>
            <span class="badge bg-danger bg-opacity-10 text-danger px-3 py-1 rounded-pill small fw-semibold mb-2">
                <i class="bi bi-people-fill me-1"></i> Student Directory
            </span>
            <h2 class="h3 fw-bold mb-1">Registered Student Profiles</h2>
            <p class="text-muted mb-0 small">Browse candidate academic details, technical skills, resume links, and application activity</p>
        </div>
        <div class="mt-2 mt-md-0 d-flex flex-wrap gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary rounded-pill px-3">
                <i class="bi bi-speedometer2 me-1"></i> Dashboard
            </a>
            <a asp-action="Applications" class="btn btn-outline-danger rounded-pill px-3">
                <i class="bi bi-person-check me-1"></i> Applications
            </a>
            <a asp-action="Jobs" class="btn btn-primary rounded-pill px-3 shadow-xs">
                <i class="bi bi-briefcase me-1"></i> Manage Drives
            </a>
        </div>
    </div>

    <!-- Quick Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="d-flex align-items-center">
                    <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-3 me-3">
                        <i class="bi bi-mortarboard-fill fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Total Registered Students</div>
                        <h4 class="fw-bold mb-0 text-dark">@Model.Count()</h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="d-flex align-items-center">
                    <div class="bg-success bg-opacity-10 text-success rounded-3 p-3 me-3">
                        <i class="bi bi-award-fill fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">High CGPA Candidates (&ge; 8.0)</div>
                        <h4 class="fw-bold mb-0 text-success">@Model.Count(s => s.Cgpa >= 8.0)</h4>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-4 col-sm-6">
            <div class="card border-0 shadow-sm rounded-4 p-3 bg-white">
                <div class="d-flex align-items-center">
                    <div class="bg-info bg-opacity-10 text-info rounded-3 p-3 me-3">
                        <i class="bi bi-send-check-fill fs-4"></i>
                    </div>
                    <div>
                        <div class="text-muted small">Active Applicants</div>
                        <h4 class="fw-bold mb-0 text-info">@Model.Count(s => s.JobApplications.Any())</h4>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Students Table -->
    <div class="card border-0 shadow-sm rounded-4 bg-white overflow-hidden">
        <div class="card-header bg-white border-bottom py-3 px-4 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0">Candidate Master List</h5>
            <span class="badge bg-light text-dark border px-3 py-2 rounded-pill">
                @Model.Count() Student@(Model.Count() == 1 ? "" : "s") Enrolled
            </span>
        </div>

        @if (!Model.Any())
        {
            <div class="text-center py-5">
                <div class="bg-light rounded-circle d-inline-flex align-items-center justify-content-center p-4 mb-3" style="width: 80px; height: 80px;">
                    <i class="bi bi-person-x text-muted fs-1"></i>
                </div>
                <h5 class="fw-bold">No registered students found</h5>
                <p class="text-muted">Students who register via the portal will automatically appear here with their academic profiles.</p>
            </div>
        }
        else
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0 table-min-width-xl">
                    <thead class="table-light text-muted small text-uppercase">
                        <tr>
                            <th class="ps-4 py-3">Student / Roll Number</th>
                            <th class="py-3">Branch & Batch</th>
                            <th class="py-3">CGPA</th>
                            <th class="py-3">Contact Details</th>
                            <th class="py-3">Key Skills</th>
                            <th class="py-3 text-center">Applications</th>
                            <th class="pe-4 py-3 text-end">Resume</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var student in Model)
                        {
                            <tr>
                                <td class="ps-4 py-3">
                                    <div class="d-flex align-items-center">
                                        <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center fw-bold me-3" style="width: 42px; height: 42px; font-size: 1.1rem;">
                                            @student.FullName.Substring(0, 1).ToUpper()
                                        </div>
                                        <div>
                                            <div class="fw-bold text-dark">@student.FullName</div>
                                            <div class="small text-muted font-monospace">
                                                <i class="bi bi-card-text me-1"></i>@(string.IsNullOrWhiteSpace(student.RollNumber) ? "N/A" : student.RollNumber)
                                            </div>
                                        </div>
                                    </div>
                                </td>
                                <td class="py-3">
                                    <div class="fw-medium text-dark">@(string.IsNullOrWhiteSpace(student.Department) ? "Not Specified" : student.Department)</div>
                                    <div class="small text-muted">
                                        Class of @(student.GraduationYear.HasValue ? student.GraduationYear.Value.ToString() : "N/A")
                                    </div>
                                </td>
                                <td class="py-3">
                                    @if (student.Cgpa.HasValue)
                                    {
                                        <span class="badge @(student.Cgpa >= 8.0 ? "bg-success" : (student.Cgpa >= 6.5 ? "bg-primary" : "bg-warning")) px-2 py-1 rounded-pill">
                                            @student.Cgpa.Value.ToString("F2") CGPA
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">Not provided</span>
                                    }
                                </td>
                                <td class="py-3">
                                    <div class="small">
                                        <a href="mailto:@student.Email" class="text-decoration-none text-dark">
                                            <i class="bi bi-envelope text-primary me-1"></i> @student.Email
                                        </a>
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(student.PhoneNumber))
                                    {
                                        <div class="small text-muted mt-1">
                                            <i class="bi bi-telephone text-secondary me-1"></i> @student.PhoneNumber
                                        </div>
                                    }
                                </td>
                                <td class="py-3" style="max-width: 200px;">
                                    @if (!string.IsNullOrWhiteSpace(student.Skills))
                                    {
                                        var skills = student.Skills.Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
                                        <div class="d-flex flex-wrap gap-1">
                                            @foreach (var skill in skills.Take(3))
                                            {
                                                <span class="badge bg-light text-dark border small">@skill</span>
                                            }
                                            @if (skills.Length > 3)
                                            {
                                                <span class="badge bg-light text-muted small">+@(skills.Length - 3) more</span>
                                            }
                                        </div>
                                    }
                                    else
                                    {
                                        <span class="text-muted small">None listed</span>
                                    }
                                </td>
                                <td class="py-3 text-center">
                                    <span class="badge @(student.JobApplications.Any() ? "bg-info bg-opacity-10 text-info border border-info" : "bg-light text-muted") rounded-pill px-3 py-1">
                                        @student.JobApplications.Count applied
                                    </span>
                                </td>
                                <td class="pe-4 py-3 text-end">
                                    @if (!string.IsNullOrWhiteSpace(student.ResumeUrl))
                                    {
                                        <a href="@student.ResumeUrl" target="_blank" rel="noopener noreferrer" class="btn btn-sm btn-outline-primary rounded-pill px-3 shadow-xs">
                                            <i class="bi bi-file-earmark-pdf me-1"></i> Resume
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="badge bg-light text-muted small">No Link</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </div>
</div>
