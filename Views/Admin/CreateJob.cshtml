@model JobListingFormViewModel
@{
    ViewData["Title"] = "Post New Campus Drive";
}

<div class="py-4">
    <!-- Breadcrumb -->
    <nav aria-label="breadcrumb" class="mb-4">
        <ol class="breadcrumb small">
            <li class="breadcrumb-item"><a asp-action="Index" class="text-decoration-none">Admin</a></li>
            <li class="breadcrumb-item"><a asp-action="Jobs" class="text-decoration-none">Drives</a></li>
            <li class="breadcrumb-item active" aria-current="page">Post New Drive</li>
        </ol>
    </nav>

    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="card border-0 shadow-sm rounded-4 bg-white">
                <div class="card-body p-3 p-md-4 p-lg-5">
                    <div class="d-flex align-items-center mb-4 pb-3 border-bottom">
                        <div class="d-inline-flex align-items-center justify-content-center bg-primary bg-opacity-10 text-primary rounded-circle p-3 me-3" style="width: 54px; height: 54px;">
                            <i class="bi bi-briefcase-fill fs-3"></i>
                        </div>
                        <div>
                            <h4 class="fw-bold mb-1">Post New Placement / Internship Drive</h4>
                            <p class="text-muted small mb-0">Publish an approved corporate campus recruitment drive for eligible college students.</p>
                        </div>
                    </div>

                    <form asp-action="CreateJob" method="post" novalidate>
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger py-2 small mb-3" role="alert"></div>

                        <div class="row">
                            <!-- Job Title -->
                            <div class="col-md-7 mb-3">
                                <label asp-for="Title" class="form-label fw-semibold small"></label>
                                <input asp-for="Title" class="form-control" placeholder="e.g. Graduate Software Development Engineer" />
                                <span asp-validation-for="Title" class="text-danger small"></span>
                            </div>

                            <!-- Company Name -->
                            <div class="col-md-5 mb-3">
                                <label asp-for="CompanyName" class="form-label fw-semibold small"></label>
                                <input asp-for="CompanyName" class="form-control" placeholder="e.g. Microsoft Corporation" />
                                <span asp-validation-for="CompanyName" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <!-- Job Type -->
                            <div class="col-md-4 mb-3">
                                <label asp-for="JobType" class="form-label fw-semibold small"></label>
                                <select asp-for="JobType" class="form-select">
                                    <option value="Full-Time">Full-Time Placement</option>
                                    <option value="Internship">Summer / Semester Internship</option>
                                </select>
                                <span asp-validation-for="JobType" class="text-danger small"></span>
                            </div>

                            <!-- Location -->
                            <div class="col-md-4 mb-3">
                                <label asp-for="Location" class="form-label fw-semibold small"></label>
                                <input asp-for="Location" class="form-control" placeholder="e.g. Bangalore / Hybrid" />
                                <span asp-validation-for="Location" class="text-danger small"></span>
                            </div>

                            <!-- Salary or Stipend -->
                            <div class="col-md-4 mb-3">
                                <label asp-for="SalaryOrStipend" class="form-label fw-semibold small"></label>
                                <input asp-for="SalaryOrStipend" class="form-control" placeholder="e.g. ₹12,00,000 / year or ₹40,000 / mo" />
                                <span asp-validation-for="SalaryOrStipend" class="text-danger small"></span>
                            </div>
                        </div>

                        <div class="row">
                            <!-- Min CGPA Cutoff -->
                            <div class="col-md-4 mb-3">
                                <label asp-for="MinCgpa" class="form-label fw-semibold small"></label>
                                <input asp-for="MinCgpa" type="number" step="0.1" min="0" max="10" class="form-control" placeholder="0.0 for No Bar" />
                                <span asp-validation-for="MinCgpa" class="text-danger small"></span>
                            </div>

                            <!-- Eligible Branches -->
                            <div class="col-md-4 mb-3">
                                <label asp-for="EligibleDepartments" class="form-label fw-semibold small"></label>
                                <input asp-for="EligibleDepartments" class="form-control" placeholder="e.g. CSE, IT, ECE" />
                                <span asp-validation-for="EligibleDepartments" class="text-danger small"></span>
                            </div>

                            <!-- Application Deadline -->
                            <div class="col-md-4 mb-3">
                                <label asp-for="Deadline" class="form-label fw-semibold small"></label>
                                <input asp-for="Deadline" type="date" class="form-control" />
                                <span asp-validation-for="Deadline" class="text-danger small"></span>
                            </div>
                        </div>

                        <!-- Description -->
                        <div class="mb-3">
                            <label asp-for="Description" class="form-label fw-semibold small"></label>
                            <textarea asp-for="Description" class="form-control" rows="4" placeholder="Detailed role description, team responsibilities, and project domain..."></textarea>
                            <span asp-validation-for="Description" class="text-danger small"></span>
                        </div>

                        <!-- Requirements -->
                        <div class="mb-4">
                            <label asp-for="Requirements" class="form-label fw-semibold small"></label>
                            <textarea asp-for="Requirements" class="form-control" rows="3" placeholder="Technical stack, prerequisite knowledge, round details..."></textarea>
                            <span asp-validation-for="Requirements" class="text-danger small"></span>
                        </div>

                        <!-- IsActive Toggle -->
                        <div class="form-check form-switch mb-4">
                            <input asp-for="IsActive" class="form-check-input" type="checkbox" role="switch" id="isActiveSwitch">
                            <label class="form-check-label fw-semibold small text-dark" for="isActiveSwitch">
                                Publish immediately and accept student applications
                            </label>
                        </div>

                        <div class="d-flex flex-wrap justify-content-between align-items-center pt-3 border-top gap-2">
                            <a asp-action="Jobs" class="btn btn-outline-secondary rounded-pill px-4">
                                <i class="bi bi-arrow-left me-1"></i> Cancel
                            </a>
                            <button type="submit" class="btn btn-primary rounded-pill px-4 fw-semibold shadow-sm">
                                <i class="bi bi-check-lg me-1"></i> Publish Campus Drive
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
